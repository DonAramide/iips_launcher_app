<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskbar_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:background="@color/dotroid_shell_blue"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:elevation="100dp">

    <!-- Left: App Pocket Button -->
    <ImageView
        android:id="@+id/btn_taskbar_pocket"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_view"
        android:contentDescription="App Pocket"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/white" />

    <!-- Separator -->
    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="8dp"
        android:background="#20FFFFFF" />

    <!-- Center: Workspace RecyclerView (Active + Pinned Apps) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/workspace_recycler"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Separator -->
    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="8dp"
        android:background="#20FFFFFF" />

    <!-- Right: Quick Actions Area -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Alerts Widget with Badge -->
        <FrameLayout
            android:id="@+id/btn_taskbar_alerts"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@color/white" />
            <TextView
                android:id="@+id/txt_alerts_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_taskbar_badge"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Guard Widget with Badge -->
        <FrameLayout
            android:id="@+id/btn_taskbar_guard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/img_guard_status"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/white" />
            <TextView
                android:id="@+id/txt_guard_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_taskbar_badge"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Device Status Widget -->
        <ImageView
            android:id="@+id/btn_taskbar_status"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/white" />

    </LinearLayout>

</LinearLayout>
