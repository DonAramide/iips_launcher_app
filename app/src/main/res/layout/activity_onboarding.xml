<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".ui.OnboardingActivity">

    <!-- Compact top chrome: serial + Wi-Fi, kept out of content flow -->
    <LinearLayout
        android:id="@+id/onboarding_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/onboarding_screen_padding"
        android:paddingTop="@dimen/onboarding_header_gap"
        android:paddingEnd="@dimen/onboarding_screen_padding"
        android:paddingBottom="@dimen/onboarding_header_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_serial_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:alpha="0.8"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="SN: P332600114704" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wifi_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Wi-Fi"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_onboarding_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboarding_top_bar">

        <!-- Step 1: Welcome (scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/onboarding_screen_padding"
                android:paddingTop="@dimen/onboarding_screen_padding_top"
                android:paddingEnd="@dimen/onboarding_screen_padding"
                android:paddingBottom="@dimen/onboarding_screen_padding">

                <ImageView
                    android:id="@+id/welcome_logo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dotroid_premium_branding"
                    app:layout_constraintBottom_toTopOf="@id/welcome_title"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="@dimen/onboarding_logo_max"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.28"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintWidth_max="@dimen/onboarding_logo_max"
                    app:layout_constraintWidth_percent="0.36"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/welcome_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Welcome"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/onboarding_welcome_title_size"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/welcome_subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/welcome_logo"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/welcome_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Your secure enterprise mobility workspace."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/onboarding_body_size"
                    app:layout_constraintBottom_toTopOf="@id/tv_wifi_status"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/welcome_title"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_wifi_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Checking network..."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toTopOf="@id/btn_get_started"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/welcome_subtitle"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_get_started"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/onboarding_button_height"
                    android:layout_marginBottom="@dimen/onboarding_button_bottom_gap"
                    android:includeFontPadding="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="GET STARTED"
                    android:textSize="@dimen/onboarding_button_text_size"
                    app:cornerRadius="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_wifi_status"
                    app:layout_constraintVertical_bias="1.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Step 2: Device & Business Setup (scrollable form + pinned continue) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/setup_watermark"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.04"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="-15"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dotroid_premium_branding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="@dimen/onboarding_watermark_max"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/onboarding_watermark_max"
                app:layout_constraintWidth_percent="0.42" />

            <ScrollView
                android:id="@+id/setup_scroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:isScrollContainer="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="@dimen/onboarding_screen_padding"
                android:paddingTop="@dimen/onboarding_screen_padding_top"
                android:paddingEnd="@dimen/onboarding_screen_padding"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toTopOf="@id/btn_setup_continue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/setup_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/onboarding_title_height"
                        android:autoSizeMaxTextSize="@dimen/onboarding_title_size"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:breakStrategy="balanced"
                        android:gravity="start|center_vertical"
                        android:maxLines="2"
                        android:text="Device &amp;\nBusiness Setup"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/onboarding_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/setup_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Set up your business name and secure the device with an administrator password."
                        android:textColor="#666666"
                        android:textSize="@dimen/onboarding_body_size" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/enrollment_token_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="Enrollment Token"
                        app:endIconContentDescription="Scan QR Code"
                        app:endIconDrawable="@drawable/ic_qr_scan"
                        app:endIconMode="custom"
                        app:endIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_enrollment_token"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/business_name_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/onboarding_field_gap"
                        android:hint="Business Name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_business_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/agent_code_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/onboarding_field_gap"
                        android:hint="Institutional Code (Optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_agent_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:text="AAA000" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/admin_password_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/onboarding_field_gap"
                        android:hint="Admin Password"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_admin_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirm_password_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/onboarding_field_gap"
                        android:hint="Confirm Password"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setup_continue"
                android:layout_width="0dp"
                android:layout_height="@dimen/onboarding_button_height"
                android:layout_marginStart="@dimen/onboarding_screen_padding"
                android:layout_marginEnd="@dimen/onboarding_screen_padding"
                android:layout_marginBottom="@dimen/onboarding_setup_continue_bottom_gap"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="CONTINUE"
                android:textSize="@dimen/onboarding_button_text_size"
                app:cornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Step 3: Registering & Syncing Policy -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="400dp"
                android:padding="@dimen/onboarding_screen_padding">

                <ProgressBar
                    android:id="@+id/sync_progress_circle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"
                    app:layout_constraintBottom_toTopOf="@id/sync_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/sync_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Registering Device"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/sync_subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sync_progress_circle" />

                <TextView
                    android:id="@+id/sync_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center"
                    android:text="Please wait while we set up the device policy and configurations."
                    android:textColor="#666666"
                    android:textSize="@dimen/onboarding_body_size"
                    app:layout_constraintBottom_toTopOf="@id/btn_retry_sync"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sync_title" />

                <Button
                    android:id="@+id/btn_retry_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retry"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sync_subtitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Step 4: Finished -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="400dp"
                android:padding="@dimen/onboarding_screen_padding">

                <ImageView
                    android:id="@+id/finish_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="20dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:layout_constraintBottom_toTopOf="@id/finish_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/finish_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Setup Complete"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/finish_subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/finish_icon" />

                <TextView
                    android:id="@+id/finish_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center"
                    android:text="Device is now enrolled and policies have been applied successfully."
                    android:textColor="#666666"
                    android:textSize="@dimen/onboarding_body_size"
                    app:layout_constraintBottom_toTopOf="@id/btn_finish"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/finish_title" />

                <Button
                    android:id="@+id/btn_finish"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/onboarding_button_height"
                    android:text="Launch Home"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/finish_subtitle"
                    app:layout_constraintVertical_bias="1.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>

</androidx.constraintlayout.widget.ConstraintLayout>
