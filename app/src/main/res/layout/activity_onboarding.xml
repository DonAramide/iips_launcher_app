<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.OnboardingActivity">

    <ProgressBar
        android:id="@+id/onboarding_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="20"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_wifi_settings"
        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="Wi-Fi"
        app:icon="@android:drawable/ic_menu_directions"
        android:textColor="@color/text_secondary"
        app:iconTint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/onboarding_progress"
        app:layout_constraintEnd_toEndOf="parent" />

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_onboarding_gradient"
        app:layout_constraintTop_toBottomOf="@id/onboarding_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Step 1: Welcome -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="40dp">

            <ImageView
                android:id="@+id/welcome_logo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/ic_dotoid_premium_branding"
                app:layout_constraintBottom_toTopOf="@id/welcome_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textSize="32sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/welcome_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/welcome_logo"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/welcome_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your secure enterprise mobility workspace."
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                app:layout_constraintBottom_toTopOf="@id/btn_get_started"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/welcome_title"
                android:layout_marginBottom="64dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_get_started"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="GET STARTED"
                android:textSize="18sp"
                android:letterSpacing="0.1"
                app:cornerRadius="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Step 2: Business Setup -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <TextView
                android:id="@+id/setup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Setup"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/setup_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set up your business name and secure the device with an administrator password."
                android:layout_marginTop="8dp"
                android:textColor="#666666"
                app:layout_constraintTop_toBottomOf="@id/setup_title"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/enrollment_token_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:hint="Enrollment Token"
                app:layout_constraintTop_toBottomOf="@id/setup_desc">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_enrollment_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/business_name_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Business Name"
                app:layout_constraintTop_toBottomOf="@id/enrollment_token_layout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_business_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/agent_code_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Agent Code (Optional)"
                app:layout_constraintTop_toBottomOf="@id/business_name_layout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_agent_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AAA000"
                    android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/admin_password_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Admin Password"
                app:passwordToggleEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/agent_code_layout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_admin_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirm_password_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Confirm Password"
                app:passwordToggleEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/admin_password_layout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_setup_continue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Continue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Step 3: Registering & Syncing Policy -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/sync_progress_circle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:layout_constraintBottom_toTopOf="@id/sync_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/sync_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registering Device"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintBottom_toTopOf="@id/sync_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sync_progress_circle"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/sync_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please wait while we set up the device policy and configurations."
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                app:layout_constraintBottom_toTopOf="@id/btn_retry_sync"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sync_title"
                android:layout_marginBottom="48dp" />

            <Button
                android:id="@+id/btn_retry_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sync_subtitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <!-- Step 4: Finished -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <ImageView
                android:id="@+id/finish_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/primary"
                app:layout_constraintBottom_toTopOf="@id/finish_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/finish_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup Complete"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintBottom_toTopOf="@id/finish_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/finish_icon"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/finish_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device is now enrolled and policies have been applied successfully."
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                app:layout_constraintBottom_toTopOf="@id/btn_finish"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/finish_title"
                android:layout_marginBottom="48dp" />

            <Button
                android:id="@+id/btn_finish"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Launch Home"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
