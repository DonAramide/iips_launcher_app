<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">


    <!-- Custom Status Bar -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Time and Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical">
            <TextView
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="none" />
            <TextView
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 1"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:alpha="0.8"
                android:maxLines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <!-- Network and SIM Status -->
        <TextView
            android:id="@+id/sim_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="No SIM"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:alpha="0.9" />

        <TextView
            android:id="@+id/network_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="WiFi"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Battery Status -->
        <TextView
            android:id="@+id/battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Admin Icon -->
        <ImageView
            android:id="@+id/admin_button"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="@color/white"
            android:alpha="0.8" />

    </LinearLayout>

    <!-- Business Owner Name in the Middle of Status Bar -->
    <TextView
        android:id="@+id/business_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:elevation="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/status_bar"
        app:layout_constraintBottom_toBottomOf="@id/status_bar"
        app:layout_constraintStart_toStartOf="@id/status_bar"
        app:layout_constraintEnd_toEndOf="@id/status_bar" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/status_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Geofence Pending Banner -->
    <TextView
        android:id="@+id/geofence_pending_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:padding="8dp"
        android:text="Geofencing setup pending admin approval"
        android:textColor="#E65100"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/status_text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/geofence_pending_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/status_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@android:drawable/ic_menu_view"
            android:tint="@color/text_secondary"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_apps_available"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

    </LinearLayout>

    <!-- Geofence Lock Overlay -->
    <LinearLayout
        android:id="@+id/geofence_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/lock_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/error" />

        <TextView
            android:id="@+id/lock_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/geofence_out_of_range"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/retry_location"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_request_location_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Request Location Authorization"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/btn_admin_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/admin_unlock"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Remote Lock Overlay -->
    <LinearLayout
        android:id="@+id/remote_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/remote_lock_logo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ic_dotroid_premium_branding"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/remote_lock_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device is locked\nPlease contact Dotroid Admin"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:id="@+id/btn_remote_admin_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/admin_unlock"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Quick Settings Panel (Moved to end for top-level elevation) -->
    <LinearLayout
        android:id="@+id/quick_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="100dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:translationY="-500dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Controls"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- WiFi Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/qs_wifi_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="@color/white" />
                <TextView
                    android:id="@+id/qs_wifi_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi: Connected"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- SIM Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/qs_sim_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/white" />
                <TextView
                    android:id="@+id/qs_sim_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM: No SIM"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Battery Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/qs_battery_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_lock_idle_low_battery"
                    app:tint="@color/white" />
                <TextView
                    android:id="@+id/qs_battery_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery: 85%"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qs_admin_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADMIN PANEL"
            android:backgroundTint="@color/white"
            android:textColor="@color/primary"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#40FFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <View
        android:id="@+id/qs_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:elevation="101dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Core Fleet Broadcast Overlay Surfaces -->
    <include layout="@layout/broadcast_rendering_overlay" />

</androidx.constraintlayout.widget.ConstraintLayout>

