<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient"
    android:padding="40dp"
    tools:context=".ui.ProvisioningStatusActivity">

    <!-- Logo / brand mark -->
    <ImageView
        android:id="@+id/provisioning_logo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_dotroid_premium_branding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <!-- Spinner shown while enrolling -->
    <ProgressBar
        android:id="@+id/provisioning_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/provisioning_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <!-- Primary status label -->
    <TextView
        android:id="@+id/provisioning_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/provisioning_progress"
        android:layout_marginTop="32dp"
        tools:text="Enrolling Device..." />

    <!-- Error detail — hidden until an error occurs -->
    <TextView
        android:id="@+id/provisioning_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="@color/error"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/provisioning_status_text"
        android:layout_marginTop="16dp"
        tools:text="Enrollment failed. Check token and retry." />

    <!-- Retry button — hidden until an error occurs -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_provisioning_retry"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="RETRY ENROLLMENT"
        android:visibility="gone"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/provisioning_footnote"
        android:layout_marginBottom="32dp" />

    <!-- Footnote -->
    <TextView
        android:id="@+id/provisioning_footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="Managed by Dotroid Enterprise System" />

</androidx.constraintlayout.widget.ConstraintLayout>
